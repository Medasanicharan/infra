# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files that may contain sensitive data
*.tfvars
*.tfvars.json
!envs/**/*.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform lock file (comment out this line if you want to commit it)
# .terraform.lock.hcl

# OS / editor
.DS_Store
*.swp
